# Entorno: development | production
APP_ENV=development

# PostgreSQL
POSTGRES_DB=miedificio
POSTGRES_USER=miedificio
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://miedificio:replace-with-a-long-random-password@db:5432/miedificio

# Autenticacion. Genere JWT_SECRET con: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Archivos
STORAGE_BACKEND=local
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=5
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=miedificio-receipts
MINIO_SECURE=false

# Correo. En desarrollo estos valores apuntan a Mailpit.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM=MiEdificio <no-reply@miedificio.local>
FRONTEND_URL=http://localhost:5173

# Administrador inicial (python -m app.cli create-admin)
INITIAL_ADMIN_EMAIL=admin@miedificio.pe
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
INITIAL_ADMIN_NAME=Administración MiEdificio
INITIAL_BUILDING_NAME=Condominio Los Cedros
INITIAL_BUILDING_ADDRESS=Av. Los Cedros 245
INITIAL_BUILDING_DISTRICT=Santiago de Surco

# Desarrollo
SEED_DEMO_DATA=true
RUN_MIGRATIONS=true
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000/api/v1
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Produccion
DOMAIN=app.example.com
